{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",          // 👈 cambiar de "./src" a "."
    "moduleResolution": "node16",
    "module": "Node16",
    "target": "ES2022",
    "types": ["node"],
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "prisma/**/*"],  // 👈 agregar prisma
  "exclude": ["node_modules", "dist"]
}