generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id       Int           @id @default(autoincrement())
  nombre   String        @unique
  creadoEn DateTime      @default(now())
  permisos RolePermiso[]
  usuarios Usuario[]
}

model Permiso {
  id     Int           @id @default(autoincrement())
  nombre String        @unique
  roles  RolePermiso[]
}

model RolePermiso {
  roleId    Int
  permisoId Int
  permiso   Permiso @relation(fields: [permisoId], references: [id])
  role      Role    @relation(fields: [roleId], references: [id])

  @@id([roleId, permisoId])
}

model Usuario {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password      String
  nombre        String?
  apellido      String?
  nombreVisible String?
  roleId        Int
  creadoEn      DateTime @default(now())
  cliente       Cliente?
  pedidos       Pedido[]
  role          Role     @relation(fields: [roleId], references: [id])
}

model Cliente {
  id           Int      @id @default(autoincrement())
  usuarioId    Int      @unique
  direccion    String?
  direccion2   String?
  region       String?
  ciudad       String?
  codigoPostal String?
  creadoEn     DateTime @default(now())
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])
  pedidos      Pedido[]
}

model Categoria {
  id         Int        @id @default(autoincrement())
  nombre     String     @unique
  slug       String     @unique
  imagen     String?
  parentId   Int?
  creadoEn   DateTime   @default(now())
  productos  Producto[]
  parent     Categoria? @relation("CategoriaHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   Categoria[] @relation("CategoriaHierarchy")

  @@index([parentId])
}

model Producto {
  id             Int        @id @default(autoincrement())
  nombre         String
  slug           String     @unique
  descripcion    String?
  precio         Decimal    @db.Decimal(10, 2)
  categoriaId    Int
  activo         Boolean    @default(true)
  creadoEn       DateTime   @default(now())
  precioOriginal Decimal?   @db.Decimal(10, 2)
  categoria      Categoria  @relation(fields: [categoriaId], references: [id])
  variantes      Variante[]
}

model Variante {
  id          Int          @id @default(autoincrement())
  productoId  Int
  color       String
  stock       Int          @default(0)
  imagenes    String[]
  activo      Boolean      @default(true)
  itemsPedido ItemPedido[]
  itemsVenta  ItemVenta[]
  producto    Producto     @relation(fields: [productoId], references: [id])
}

model Pedido {
  id        Int          @id @default(autoincrement())
  usuarioId Int
  clienteId Int
  estado    EstadoPedido @default(PENDIENTE)
  total     Decimal      @db.Decimal(10, 2)
  creadoEn  DateTime     @default(now())
  items     ItemPedido[]
  pago      Pago?
  cliente   Cliente      @relation(fields: [clienteId], references: [id])
  usuario   Usuario      @relation(fields: [usuarioId], references: [id])
  venta     Venta?
}

model ItemPedido {
  id         Int      @id @default(autoincrement())
  pedidoId   Int
  varianteId Int
  cantidad   Int
  precio     Decimal  @db.Decimal(10, 2)
  pedido     Pedido   @relation(fields: [pedidoId], references: [id])
  variante   Variante @relation(fields: [varianteId], references: [id])
}

model Pago {
  id         Int        @id @default(autoincrement())
  pedidoId   Int        @unique
  metodo     MetodoPago
  estado     EstadoPago @default(PENDIENTE)
  referencia String?
  total      Decimal    @db.Decimal(10, 2)
  creadoEn   DateTime   @default(now())
  pedido     Pedido     @relation(fields: [pedidoId], references: [id])
}

model Venta {
  id       Int         @id @default(autoincrement())
  pedidoId Int         @unique
  total    Decimal     @db.Decimal(10, 2)
  creadoEn DateTime    @default(now())
  items    ItemVenta[]
  pedido   Pedido      @relation(fields: [pedidoId], references: [id])
}

model ItemVenta {
  id         Int      @id @default(autoincrement())
  ventaId    Int
  varianteId Int
  cantidad   Int
  precio     Decimal  @db.Decimal(10, 2)
  variante   Variante @relation(fields: [varianteId], references: [id])
  venta      Venta    @relation(fields: [ventaId], references: [id])
}

model PasswordResetOtp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  expiresAt DateTime
  usado     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_otp")
}

model RegistroToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @default(uuid())
  email     String
  nombre    String
  telefono  String
  telefono2 String?
  usado     Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("registro_token")
}

model GaleriaImagen {
  id        Int      @id @default(autoincrement())
  url       String
  publicId  String   @unique
  caption   String?
  orden     Int      @unique
  creadoEn  DateTime @default(now())
}

model BannerSlide {
  id        Int      @id @default(autoincrement())
  url       String
  publicId  String   @unique
  titulo    String
  subtitulo String
  desc      String?
  orden     Int      @unique
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())
}

enum EstadoPedido {
  PENDIENTE
  PAGADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum MetodoPago {
  PSE
  NEQUI
  DAVIPLATA
  WHATSAPP
  TRANSFERENCIA
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
}
