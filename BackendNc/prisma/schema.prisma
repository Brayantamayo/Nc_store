generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ROLES Y PERMISOS ───────────────────────────────

model Role {
  id          Int           @id @default(autoincrement())
  nombre      String        @unique
  permisos    RolePermiso[]
  usuarios    Usuario[]
  creadoEn    DateTime      @default(now())
}

model Permiso {
  id          Int           @id @default(autoincrement())
  nombre      String        @unique
  roles       RolePermiso[]
}

model RolePermiso {
  roleId      Int
  permisoId   Int
  role        Role          @relation(fields: [roleId], references: [id])
  permiso     Permiso       @relation(fields: [permisoId], references: [id])

  @@id([roleId, permisoId])
}

// ─── USUARIOS ────────────────────────────────────────

model Usuario {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  password    String
  nombre      String?
  apellido    String?
  nombreVisible  String?
  roleId      Int
  role        Role      @relation(fields: [roleId], references: [id])
  cliente     Cliente?
  pedidos     Pedido[]
  creadoEn    DateTime  @default(now())
}

// ─── CLIENTES ────────────────────────────────────────

model Cliente {
  id           Int       @id @default(autoincrement())
  usuarioId    Int       @unique
  usuario      Usuario   @relation(fields: [usuarioId], references: [id])
  direccion    String?
  direccion2   String?
  region       String?
  ciudad       String?
  codigoPostal String?
  pedidos      Pedido[]
  creadoEn     DateTime  @default(now())
}

// ─── CATEGORÍAS Y PRODUCTOS ──────────────────────────

model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique
  slug        String     @unique
  imagen      String?
  productos   Producto[]
  creadoEn    DateTime   @default(now())
}

model Producto {
  id          Int        @id @default(autoincrement())
  nombre      String
  slug        String     @unique
  descripcion String?
  precio      Decimal    @db.Decimal(10, 2)
  categoriaId Int
  categoria   Categoria  @relation(fields: [categoriaId], references: [id])
  activo      Boolean    @default(true)
  variantes   Variante[]
  creadoEn    DateTime   @default(now())
}

model Variante {
  id          Int          @id @default(autoincrement())
  productoId  Int
  producto    Producto     @relation(fields: [productoId], references: [id])
  color       String
  stock       Int          @default(0)
  imagenes    String[]
  itemsPedido ItemPedido[]
  itemsVenta  ItemVenta[]
}

// ─── PEDIDOS ─────────────────────────────────────────

model Pedido {
  id          Int          @id @default(autoincrement())
  usuarioId   Int
  usuario     Usuario      @relation(fields: [usuarioId], references: [id])
  clienteId   Int
  cliente     Cliente      @relation(fields: [clienteId], references: [id])
  estado      EstadoPedido @default(PENDIENTE)
  total       Decimal      @db.Decimal(10, 2)
  items       ItemPedido[]
  pago        Pago?
  venta       Venta?
  creadoEn    DateTime     @default(now())
}

enum EstadoPedido {
  PENDIENTE
  PAGADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

model ItemPedido {
  id          Int      @id @default(autoincrement())
  pedidoId    Int
  pedido      Pedido   @relation(fields: [pedidoId], references: [id])
  varianteId  Int
  variante    Variante @relation(fields: [varianteId], references: [id])
  cantidad    Int
  precio      Decimal  @db.Decimal(10, 2)
}

// ─── PAGOS ───────────────────────────────────────────

model Pago {
  id          Int        @id @default(autoincrement())
  pedidoId    Int        @unique
  pedido      Pedido     @relation(fields: [pedidoId], references: [id])
  metodo      MetodoPago
  estado      EstadoPago @default(PENDIENTE)
  referencia  String?
  total       Decimal    @db.Decimal(10, 2)
  creadoEn    DateTime   @default(now())
}

enum MetodoPago {
  PSE
  NEQUI
  DAVIPLATA
  WHATSAPP
  TRANSFERENCIA
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// ─── VENTAS ──────────────────────────────────────────

model Venta {
  id          Int        @id @default(autoincrement())
  pedidoId    Int        @unique
  pedido      Pedido     @relation(fields: [pedidoId], references: [id])
  total       Decimal    @db.Decimal(10, 2)
  items       ItemVenta[]
  creadoEn    DateTime   @default(now())
}

model ItemVenta {
  id          Int      @id @default(autoincrement())
  ventaId     Int
  venta       Venta    @relation(fields: [ventaId], references: [id])
  varianteId  Int
  variante    Variante @relation(fields: [varianteId], references: [id])
  cantidad    Int
  precio      Decimal  @db.Decimal(10, 2)
}